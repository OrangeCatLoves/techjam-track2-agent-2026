# Copy this file to `.env` in the repo root and fill in real values.
# `.env` is gitignored. Never commit it, never print it, never log it.

# Set to "none" to run the whole pipeline in deterministic mode with no LLM calls.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Cheap model for routine diagnosis and one-shot code repair.
LLM_MODEL_FAST=claude-opus-5

# Stronger model for experiment proposals and plateau breaks.
LLM_MODEL_STRONG=claude-opus-5

# Absolute path to the extracted dataset directory containing the six CSVs.
# Windows example: C:/Users/Lenovo/track2-techjam/data/KuaiRand-Pure/data
# WSL/Linux example: /home/you/techjam/data/KuaiRand-Pure/data
KUAIRAND_DATA_DIR=
